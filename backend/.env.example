# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Get this from MongoDB Atlas -> Connect -> Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/project_vault?retryWrites=true&w=majority

# JWT Authentication
# Use a long random string (at least 32 characters)
JWT_SECRET=replace_with_a_long_random_secret_key_at_least_32_chars
JWT_EXPIRES_IN=7d

# Initial Administrator Account (created automatically on first startup if no admin exists)
ADMIN_EMAIL=admin@projectvault.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMeToAStrongPassword123!

# CORS - Comma-separated list of allowed frontend URLs
CLIENT_URL=http://localhost:5173

# Cloudinary Configuration (Required for persistent image & PDF storage)
# Get these from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: Set to 'true' to seed the UNFAZED sample project automatically if DB is empty
SEED_SAMPLE_PROJECT=false
